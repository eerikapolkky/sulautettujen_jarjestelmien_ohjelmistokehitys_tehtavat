// 3 pistettä: RYG-sekvenssin taskikohtaiset suoritusajat
// ja kokonaisaika mikrosekunteina, mittaukset debug päällä/pois.
//
// Erillinen matalan prioriteetin debug-task ja FIFO debug-viesteille.
// UART-komento D vaihtaa debug-tulostukset päälle/pois.
//
// Lisättty:
// - HHMMSS time parser
// - liikennevalosekvenssin parser
// - Zephyr timer
// - timer laukaisee RED-komennon dispatcherille
// - S-komennolla voidaan antaa R/Y/G-sekvenssi

#include <zephyr/kernel.h>
#include <zephyr/sys/printk.h>
#include <zephyr/device.h>
#include <zephyr/drivers/gpio.h>
#include <zephyr/drivers/uart.h>

#include <stdio.h>
#include <stdbool.h>
#include <stdint.h>
#include <stdlib.h>
#include <string.h>
#include <ctype.h>


// Time parser error codes
#define TIME_LEN_ERROR        -1
#define TIME_ARRAY_ERROR      -2
#define TIME_VALUE_ERROR      -3
#define TIME_CHAR_ERROR       -4
#define TIME_ZERO_ERROR       -5

// Traffic sequence parser error codes
#define SEQUENCE_ERROR_NULL   -10
#define SEQUENCE_ERROR_EMPTY  -11
#define SEQUENCE_ERROR_CHAR   -12


// Red = led0
static const struct gpio_dt_spec red =
    GPIO_DT_SPEC_GET(DT_ALIAS(led0), gpios);

// Green = led1
static const struct gpio_dt_spec green =
    GPIO_DT_SPEC_GET(DT_ALIAS(led1), gpios);

// Blue = led2
static const struct gpio_dt_spec blue =
    GPIO_DT_SPEC_GET(DT_ALIAS(led2), gpios);


// UART

#define UART_DEVICE_NODE DT_CHOSEN(zephyr_console)

static const struct device *const uart_dev =
    DEVICE_DT_GET(UART_DEVICE_NODE);


// DISPATCHER FIFO
K_FIFO_DEFINE(dispatcher_fifo);

struct data_t {
    void *fifo_reserved;
    char color;
};


// DEBUG FIFO

K_FIFO_DEFINE(debug_fifo);

struct debug_data_t {
    void *fifo_reserved;
    char msg[64];
};


bool debug_enabled = true;

uint64_t red_time_us = 0;
uint64_t yellow_time_us = 0;
uint64_t green_time_us = 0;

// RED
K_MUTEX_DEFINE(red_mutex);
K_CONDVAR_DEFINE(red_signal);

// YELLOW
K_MUTEX_DEFINE(yellow_mutex);
K_CONDVAR_DEFINE(yellow_signal);

// GREEN
K_MUTEX_DEFINE(green_mutex);
K_CONDVAR_DEFINE(green_signal);


bool red_requested = false;
bool yellow_requested = false;
bool green_requested = false;


// Dispatcher waits for light task to finish
K_SEM_DEFINE(release_sem, 0, 1);



K_SEM_DEFINE(timer_sem, 0, 1);


int init_led(void);
int init_uart(void);

void send_debug(const char *msg);

void uart_task(void *, void *, void *);
void dispatcher_task(void *, void *, void *);

void red_led_task(void *, void *, void *);
void yellow_led_task(void *, void *, void *);
void green_led_task(void *, void *, void *);

void debug_task(void *, void *, void *);

void timer_expiry_handler(struct k_timer *timer);
void timer_task(void *, void *, void *);

void queue_color(char color);

int time_parse(char *time);
int sequence_parse(char *sequence);


// Timer must be defined after timer callback prototype
K_TIMER_DEFINE(
    traffic_timer,
    timer_expiry_handler,
    NULL
);

// THREADS

#define STACKSIZE 1024
#define PRIORITY 5
#define DEBUG_PRIORITY 7


// UART thread
K_THREAD_DEFINE(
    uart_thread,
    STACKSIZE,
    uart_task,
    NULL,
    NULL,
    NULL,
    PRIORITY,
    0,
    0
);


// Dispatcher thread
K_THREAD_DEFINE(
    dispatcher_thread,
    STACKSIZE,
    dispatcher_task,
    NULL,
    NULL,
    NULL,
    PRIORITY,
    0,
    0
);


// Red light thread
K_THREAD_DEFINE(
    red_thread,
    STACKSIZE,
    red_led_task,
    NULL,
    NULL,
    NULL,
    PRIORITY,
    0,
    0
);


// Yellow light thread
K_THREAD_DEFINE(
    yellow_thread,
    STACKSIZE,
    yellow_led_task,
    NULL,
    NULL,
    NULL,
    PRIORITY,
    0,
    0
);


// Green light thread
K_THREAD_DEFINE(
    green_thread,
    STACKSIZE,
    green_led_task,
    NULL,
    NULL,
    NULL,
    PRIORITY,
    0,
    0
);


// Debug thread
K_THREAD_DEFINE(
    debug_thread,
    STACKSIZE,
    debug_task,
    NULL,
    NULL,
    NULL,
    DEBUG_PRIORITY,
    0,
    0
);


// Timer worker thread
K_THREAD_DEFINE(
    timer_thread,
    STACKSIZE,
    timer_task,
    NULL,
    NULL,
    NULL,
    PRIORITY,
    0,
    0
);

int main(void)
{
    int ret;

    ret = init_led();

    if (ret < 0) {
        printk("LED initialization failed\n");
        return 0;
    }

    ret = init_uart();

    if (ret < 0) {
        printk("UART initialization failed\n");
        return 0;
    }

    printk("Main started\n");
    printk("Commands:\n");
    printk("R = red, Y = yellow, G = green\n");
    printk("D = debug ON/OFF\n");
    printk("HHMMSS = start timer\n");
    printk("S + RYG sequence + Enter = run sequence\n");

    while (true) {
        k_msleep(1000);
    }

    return 0;
}

// LED INITIALIZATION

int init_led(void)
{
    int ret;

    ret = gpio_pin_configure_dt(
        &red,
        GPIO_OUTPUT_ACTIVE
    );

    if (ret < 0) {
        printk("Error: Red LED configure failed\n");
        return ret;
    }

    ret = gpio_pin_configure_dt(
        &green,
        GPIO_OUTPUT_ACTIVE
    );

    if (ret < 0) {
        printk("Error: Green LED configure failed\n");
        return ret;
    }

    ret = gpio_pin_configure_dt(
        &blue,
        GPIO_OUTPUT_ACTIVE
    );

    if (ret < 0) {
        printk("Error: Blue LED configure failed\n");
        return ret;
    }

    gpio_pin_set_dt(&red, 0);
    gpio_pin_set_dt(&green, 0);
    gpio_pin_set_dt(&blue, 0);

    printk("LEDs initialized OK\n");

    return 0;
}



int init_uart(void)
{
    if (!device_is_ready(uart_dev)) {

        printk("UART device not ready\n");

        return -1;
    }

    printk("UART initialized OK\n");

    return 0;
}


// SEND DEBUG MESSAGE

void send_debug(const char *msg)
{
    if (!debug_enabled) {
        return;
    }

    struct debug_data_t *buf =
        k_malloc(sizeof(struct debug_data_t));

    if (buf == NULL) {
        return;
    }

    snprintf(
        buf->msg,
        sizeof(buf->msg),
        "%s",
        msg
    );

    k_fifo_put(
        &debug_fifo,
        buf
    );
}

// DEBUG TASK

void debug_task(void *, void *, void *)
{
    while (true) {

        struct debug_data_t *item =
            k_fifo_get(
                &debug_fifo,
                K_FOREVER
            );

        printk("%s\n", item->msg);

        k_free(item);
    }
}

// PUT COLOR INTO DISPATCHER FIFO

void queue_color(char color)
{
    struct data_t *buf =
        k_malloc(sizeof(struct data_t));

    if (buf == NULL) {

        printk("Memory allocation failed\n");
        return;
    }

    buf->color = color;

    k_fifo_put(
        &dispatcher_fifo,
        buf
    );
}

// UART TASK
void uart_task(void *, void *, void *)
{
    char rc;

    // HHMMSS + null terminator
    char time_buffer[7];
    int time_index = 0;

    // Traffic light sequence
    char sequence_buffer[32];
    int sequence_index = 0;

    bool sequence_mode = false;

    while (true) {

        if (uart_poll_in(uart_dev, &rc) == 0) {

            // ------------------------------------------------
            // SEQUENCE MODE
            //
            // S
            // RYGRYG
            // Enter
            // ------------------------------------------------

            if (sequence_mode) {

                if (rc == '\r' || rc == '\n') {

                    sequence_buffer[sequence_index] = '\0';

                    int result =
                        sequence_parse(sequence_buffer);

                    if (result == 0) {

                        printk(
                            "Valid sequence: %s\n",
                            sequence_buffer
                        );

                        for (
                            int i = 0;
                            sequence_buffer[i] != '\0';
                            i++
                        ) {

                            queue_color(
                                sequence_buffer[i]
                            );
                        }

                    } else {

                        printk(
                            "Invalid sequence, error: %d\n",
                            result
                        );
                    }

                    sequence_index = 0;
                    sequence_mode = false;
                }

                else {

                    if (
                        sequence_index <
                        (int)sizeof(sequence_buffer) - 1
                    ) {

                        sequence_buffer[sequence_index++] =
                            rc;

                    } else {

                        printk("Sequence too long\n");

                        sequence_index = 0;
                        sequence_mode = false;
                    }
                }
            }


            // ------------------------------------------------
            // S = START SEQUENCE INPUT
            // ------------------------------------------------

            else if (rc == 'S') {

                sequence_mode = true;
                sequence_index = 0;

                printk(
                    "Enter R/Y/G sequence and press Enter\n"
                );
            }
            // D = DEBUG ON/OFF

            else if (rc == 'D') {

                debug_enabled =
                    !debug_enabled;

                if (debug_enabled) {

                    printk("DEBUG ON\n");

                } else {

                    printk("DEBUG OFF\n");
                }
            }

            // DIGIT = PART OF HHMMSS TIME STRING

            else if (
                rc >= '0' &&
                rc <= '9'
            ) {

                time_buffer[time_index++] = rc;

                if (time_index == 6) {

                    time_buffer[6] = '\0';

                    printk(
                        "Received time: %s\n",
                        time_buffer
                    );

                    /*
                     * time_parse modifies the string when
                     * splitting HH, MM and SS.
                     */
                    int seconds =
                        time_parse(time_buffer);

                    if (seconds > 0) {

                        printk(
                            "Timer started: %d seconds\n",
                            seconds
                        );

                        k_timer_start(
                            &traffic_timer,
                            K_SECONDS(seconds),
                            K_NO_WAIT
                        );

                    } else {

                        printk(
                            "Invalid time, error: %d\n",
                            seconds
                        );
                    }

                    time_index = 0;
                }
            }

            // NORMAL R / Y / G COMMAND

            else if (
                rc == 'R' ||
                rc == 'Y' ||
                rc == 'G'
            ) {

                queue_color(rc);
            }
        }

        k_msleep(10);
    }
}


// TIMER CALLBACK

void timer_expiry_handler(struct k_timer *timer)
{
    ARG_UNUSED(timer);

    // Keep callback short.
    // Actual work is done by timer_task.
    k_sem_give(&timer_sem);
}

// TIMER TASK

void timer_task(void *, void *, void *)
{
    while (true) {

        k_sem_take(
            &timer_sem,
            K_FOREVER
        );

        printk("Timer expired -> RED\n");

        // Use existing dispatcher system
        queue_color('R');
    }
}

void dispatcher_task(void *, void *, void *)
{
    char msg[64];

    while (true) {

        struct data_t *item =
            k_fifo_get(
                &dispatcher_fifo,
                K_FOREVER
            );

        char color = item->color;

        k_free(item);

        snprintf(
            msg,
            sizeof(msg),
            "Dispatcher received: %c",
            color
        );

        send_debug(msg);


        // RED
        if (color == 'R') {

            send_debug("Dispatcher -> RED");

            k_mutex_lock(
                &red_mutex,
                K_FOREVER
            );

            red_requested = true;

            k_condvar_signal(
                &red_signal
            );

            k_mutex_unlock(
                &red_mutex
            );
        }


        // YELLOW
        else if (color == 'Y') {

            send_debug("Dispatcher -> YELLOW");

            k_mutex_lock(
                &yellow_mutex,
                K_FOREVER
            );

            yellow_requested = true;

            k_condvar_signal(
                &yellow_signal
            );

            k_mutex_unlock(
                &yellow_mutex
            );
        }


        // GREEN
        else if (color == 'G') {

            send_debug("Dispatcher -> GREEN");

            k_mutex_lock(
                &green_mutex,
                K_FOREVER
            );

            green_requested = true;

            k_condvar_signal(
                &green_signal
            );

            k_mutex_unlock(
                &green_mutex
            );
        }


        // Wait until selected light task finishes
        k_sem_take(
            &release_sem,
            K_FOREVER
        );
    }
}

// RED TASK

void red_led_task(void *, void *, void *)
{
    while (true) {

        k_mutex_lock(
            &red_mutex,
            K_FOREVER
        );

        while (!red_requested) {

            k_condvar_wait(
                &red_signal,
                &red_mutex,
                K_FOREVER
            );
        }

        red_requested = false;

        k_mutex_unlock(
            &red_mutex
        );


        // START TIMING
        uint32_t start_time =
            k_cycle_get_32();


        // RED ON
        gpio_pin_set_dt(
            &red,
            1
        );

        send_debug("RED ON");


        k_sleep(
            K_SECONDS(1)
        );


        // RED OFF
        gpio_pin_set_dt(
            &red,
            0
        );

        send_debug("RED OFF");


        // STOP TIMING
        uint32_t end_time =
            k_cycle_get_32();

        red_time_us =
            k_cyc_to_us_floor64(
                end_time - start_time
            );

        printk(
            "RED task time: %llu us\n",
            red_time_us
        );


        k_sem_give(
            &release_sem
        );
    }
}

