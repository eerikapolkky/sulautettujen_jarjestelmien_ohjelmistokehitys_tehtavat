        );
    }
}


// TIME PARSER
// Format:
// HHMMSS
// Esim. 000120 = 1 minute 20 seconds = 80 seconds

int time_parse(char *time)
{
    if (time == NULL) {
        return TIME_ARRAY_ERROR;
    }

    if (strlen(time) != 6) {
        return TIME_LEN_ERROR;
    }

    // Only numbers allowed
    for (int i = 0; i < 6; i++) {

        if (!isdigit((unsigned char)time[i])) {
            return TIME_CHAR_ERROR;
        }
    }

    int values[3];

    // seconds
    values[2] =
        atoi(time + 4);

    time[4] = '\0';


    // minutes
    values[1] =
        atoi(time + 2);

    time[2] = '\0';


    // hours
    values[0] =
        atoi(time);


    // Hours: 0-23
    if (
        values[0] < 0 ||
        values[0] > 23
    ) {

        return TIME_VALUE_ERROR;
    }


    // Minutes: 0-59
    if (
        values[1] < 0 ||
        values[1] > 59
    ) {

        return TIME_VALUE_ERROR;
    }


    // Seconds: 0-59
    if (
        values[2] < 0 ||
        values[2] > 59
    ) {

        return TIME_VALUE_ERROR;
    }


    // Only minutes + seconds are used
    int seconds =
        values[1] * 60 +
        values[2];


    if (seconds == 0) {
        return TIME_ZERO_ERROR;
    }


    return seconds;
}


// TRAFFIC LIGHT SEQUENCE PARSER
// R, Y, G


int sequence_parse(char *sequence)
{
    if (sequence == NULL) {
        return SEQUENCE_ERROR_NULL;
    }

    if (strlen(sequence) == 0) {
        return SEQUENCE_ERROR_EMPTY;
    }

    for (
        int i = 0;
        sequence[i] != '\0';
        i++
    ) {

        if (
            sequence[i] != 'R' &&
            sequence[i] != 'Y' &&
            sequence[i] != 'G'
        ) {

            return SEQUENCE_ERROR_CHAR;
        }
    }

    return 0;
}
